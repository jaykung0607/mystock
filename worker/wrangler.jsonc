{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mystock",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // 前端靜態檔（web/ build 輸出）。/api/* 先交給 Worker，其餘走靜態檔、SPA fallback。
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mystock",
      // 執行 `wrangler d1 create mystock` 後把 id 填在這裡（見 docs/SETUP.md）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 非機密設定。ACCESS_TEAM_DOMAIN / ACCESS_AUD 見 docs/SETUP.md。
  // 本機開發用 .dev.vars 覆寫（ENVIRONMENT=development、DEV_AUTH_EMAIL）。
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://YOUR-TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG"
  },

  // 每日排程（UTC）。每次都會檢查並補抓缺的資料，可重跑。
  //   07:00 = 台灣 15:00（台股收盤後）
  //   08:30 = 台灣 16:30（台股重試 + 台銀匯率）
  //   22:30 = 台灣隔天 06:30（美股收盤後，夏令／冬令都已收盤）
  //   12:00 = 台灣 20:00 每天一次（週末也跑：補缺漏、重算快照）
  "triggers": {
    "crons": ["0 7 * * 1-5", "30 8 * * 1-5", "30 22 * * 1-5", "0 12 * * *"]
  },

  "observability": { "enabled": true }
}
